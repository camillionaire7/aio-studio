{
  "name": "aio-converter",
  "version": "1.0.0",
  "description": "Convert Hayha and Polar AIO profile and account files in both directions",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js && node test/builder.test.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.local.aioconverter",
    "productName": "PokeSluts AIO Convertr",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}