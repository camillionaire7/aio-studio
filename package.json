{
  "name": "aio-converter",
  "version": "1.0.0",
  "description": "Convert Hayha and Polar AIO profile and account files in both directions",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js && node test/builder.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --x64 --arm64"
  },
  "build": {
    "appId": "com.local.aioconverter",
    "productName": "PokeSluts AIO Studio",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true
    },
    "afterPack": "build/adHocSign.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}