{
  "name": "aio-studio",
  "version": "2.0.0",
  "description": "PokeSluts AIO Studio - Vault, Profile Builder, Duplicate Editor, and Hayha/Polar Converter",
  "author": "PokeSluts",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js && node test/builder.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.pokesluts.aiostudio",
    "productName": "PokeSluts AIO Studio",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}